# ---------------------------------------------------------------------------
# Ocean Warrior | Planetary Pulse — environment configuration
# Copy to .env.local for local development. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# REQUIRED. The prototype password gate. Set a real value in Vercel.
APP_PASSWORD=CHANGE_ME

# REQUIRED. Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# OPTIONAL data-source credentials.
# Every layer below works as a "credentials required" connector without these.
# Nothing is faked when they are absent.
# ---------------------------------------------------------------------------

# Copernicus Marine (https://marine.copernicus.eu) — unlocks live surface
# currents and surface salinity.
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# NASA Earthdata (https://urs.earthdata.nasa.gov) — unlocks authenticated
# PO.DAAC subsetting. NOTE: MUR SST and MUR SST anomaly are ALSO available
# without credentials as public GIBS tiles, which is what V1 uses.
EARTHDATA_TOKEN=

# Global Fishing Watch (https://globalfishingwatch.org/our-apis/) — unlocks
# apparent fishing effort. Token issued on request.
GLOBAL_FISHING_WATCH_TOKEN=
